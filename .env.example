# Supabase (from `supabase status` locally, or the project dashboard once linked)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-side / edge functions only, never ship to the client

# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are already
# injected automatically into every edge function once deployed, so nothing
# here needs to be pushed as a function secret. This file is only needed for
# local tooling that runs outside the edge function runtime.
#
# Resend account API keys and webhook signing secrets are NOT set here.
# They're added from the admin panel (Admin -> Resend accounts) after
# deploying, stored in the resend_accounts table, and never touch the CLI
# or an env file - see AdminResendAccountsPage.tsx / README.md.
